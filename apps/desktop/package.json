{
  "name": "@multi-publish/desktop",
  "version": "0.1.0",
  "description": "婢舵艾閽╅崣鏉垮敶鐎归€涚闁款喖褰傜敮鍐╊攽闂堛垻顏?(Electron + RpaViewManager)",
  "author": "Colin Chiu <colin.chiu@colinchiu.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev:vue": "vite",
    "dev:electron": "pnpm run build:preload && wait-on http://localhost:5174 && electron .",
    "dev": "node scripts/dev.js",
    "build:preload": "node scripts/build-preload.js",
    "build:vue": "pnpm run build:preload && vite build",
    "build": "pnpm run build:vue && electron-builder",
    "build:win": "pnpm run build:vue && electron-builder --win --x64",
    "build:dir": "pnpm run build:vue && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest run",
    "build:ts": "tsc",
    "lint": "eslint electron/ src/ --quiet",
    "lint:warnings": "eslint electron/ src/",
    "lint:fix": "eslint electron/ src/ --fix",
    "format": "prettier --check \"electron/**/*.js\" \"src/**/*.{js,vue}\"",
    "format:write": "prettier --write \"electron/**/*.js\" \"src/**/*.{js,vue}\"",
    "check:ts": "tsc -p tsconfig.check.json --noEmit",
    "check:all": "pnpm run check:ts && pnpm run lint && pnpm run test",
    "test:visual": "node tests/visual-testing/views/all-views.visual.test.js",
    "test:workflow": "node tests/visual-testing/workflows/all-workflows.visual.test.js",
    "test:visual:ci": "node tests/visual-testing/scripts/visual-ci.js",
    "test:visual:update-baseline": "cross-env UPDATE_BASELINE=1 node tests/visual-testing/scripts/run-pixel-tests.js",
    "test:visual:quick": "node tests/visual-testing/views/all-views.visual.test.js --single home-default",
    "test:all:visual": "node tests/visual-testing/views/all-views.visual.test.js && node tests/visual-testing/views/supplementary-views.visual.test.js && node tests/visual-testing/workflows/all-workflows.visual.test.js && node tests/visual-testing/workflows/supplementary-workflows.visual.test.js",
    "test:visual:pixel": "node tests/visual-testing/scripts/run-pixel-tests.js",
    "test:visual:mp:capture": "node tests/visual-testing/scripts/capture-mp-current.js",
    "test:visual:mp": "node tests/visual-testing/scripts/compare-mp.js",
    "test:visual:agent": "node tests/visual-testing/scripts/agent-visual-judge.js",
    "test:ai:autonomous": "node ../../packages/ai-autonomous-tester/scripts/run-autonomous.js",
    "test:visual:supplement": "node tests/visual-testing/views/supplementary-views.visual.test.js",
    "test:workflow:supplement": "node tests/visual-testing/workflows/supplementary-workflows.visual.test.js",
    "test:functional": "node tests/visual-testing/functional-test.js",
    "test:autonomous-loop": "node tests/visual-testing/autonomous-loop.js",
    "test:full-regression": "node tests/visual-testing/autonomous-loop.js --max-rounds 3",
    "test:fix-loop": "node tests/visual-testing/autonomous-fix-loop.js",
    "test:enforce": "node tests/visual-testing/autonomous-enforce-loop.js",
    "test:mutation": "cd ../.. && pnpm exec stryker run stryker.conf.json",
    "test:mutation:identity": "stryker run stryker.identity.conf.json",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --no-file-parallelism",
    "test:fault": "cross-env INJECT_FAULTS=1 vitest run electron/tests/fault-injection.test.js",
    "test:monkey": "vitest run electron/tests/monkey.test.js",
    "test:quality": "pnpm run test:fault && pnpm run test:monkey",
    "test:e2e": "node tests/e2e/helpers/run-all.js",
    "test:e2e:identity": "node tests/e2e/identity-menu.e2e.js",
    "test:e2e:routes": "node tests/e2e/helpers/run-all.js routes",
    "test:e2e:film-engineering": "node tests/e2e/film-engineering-real.js",
    "test:e2e:flows": "node tests/e2e/helpers/run-all.js flows",
    "test:e2e:b1": "node tests/e2e/specs/b1-core-publish.js",
    "test:e2e:accounts": "node tests/e2e/specs/account-management-full.js",
    "test:startup": "vitest run --config vitest.smoke.config.js",
    "test:preload:sandbox": "pnpm run build:preload && node scripts/verify-preload-sandbox.js"
  },
  "keywords": [
    "multi-publish",
    "rpa",
    "wechat"
  ],
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@logto/client": "3.1.8",
    "@multi-publish/ai-writer": "workspace:*",
    "@multi-publish/api-publish-engine": "workspace:*",
    "@multi-publish/collection-engine": "workspace:*",
    "@multi-publish/rewrite-engine": "workspace:*",
    "@multi-publish/rpa-engine": "workspace:*",
    "@multi-publish/shared-utils": "workspace:*",
    "@multi-publish/story2video-engine": "workspace:*",
    "@multi-publish/video-clone-engine": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueup/vue-quill": "^1.5.3",
    "axios": "^1.9.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.2",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1",
    "fuse.js": "^7.4.2",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "mammoth": "^1.12.2",
    "pinia": "^2.3.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "segmentit": "^2.0.3",
    "sql.js": "^1.11.0",
    "vite": "^6.3.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@multi-publish/ai-autonomous-tester": "workspace:*",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "es-module-lexer": "^3.0.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "tesseract.js": "^5.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "beforePack": "scripts/before-pack.js",
    "appId": "com.colinchiu.multi-publish",
    "productName": "Multi-Publish",
    "directories": {
      "output": "dist-electron"
    },
    "electronVersion": "43.1.1",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.pnpm/**",
      "!node_modules/ffmpeg-ffprobe-static/ffmpeg*",
      "!node_modules/ffmpeg-ffprobe-static/ffprobe*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/fonts",
        "to": "fonts"
      },
      {
        "from": "../../config",
        "to": "config"
      },
      {
        "from": ".playwright-browsers",
        "to": "playwright-browsers"
      },
      {
        "from": ".media-tools",
        "to": "media-tools"
      },
      {
        "from": "../../packages/remotion-composer",
        "to": "packages/remotion-composer",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": ".remotion-runtime/node_modules",
        "to": "packages/remotion-composer/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": null,
      "sign": false,
      "signAndEditExecutable": false,
      "signDlls": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Colinchiu007",
      "repo": "Multi-Publish"
    }
  }
}
