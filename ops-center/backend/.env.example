OPS_DB_PATH=/data/ops-center/config.db
OPS_CONFIG_OUTPUT_DIR=/data/configs
OPS_ENCRYPTION_KEY=<generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
OPS_SECRET_KEY=<same as PO_SECRET_KEY>
OPS_JWT_SECRET=<generate a strong random key, e.g. openssl rand -hex 32>
# JWT 密钥独立于 OPS_SECRET_KEY（Stage -1.8 解耦），不再共享
OPS_JWT_ALGORITHM=HS256
OPS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 生产环境请替换为实际前端域名，多个用逗号分隔；请勿使用 *
# 模型目录只读同步端点（桌面端拉取运营配置）API Key；未配置 → 端点 404（fail-closed）
OPS_CATALOG_API_KEY=<generate a strong random key, e.g. openssl rand -hex 32>
# 本地管理员登录（自包含，替代 orchestrator 认证）：未配置且无管理员时登录 fail-closed
# 允许「获取模型ID URL」解析到 198.18.0.0/15（RFC 2544 基准测试段）：Clash/TUN fake-ip 代理
# 用它接管公网流量，公网模型 API 域名在代理环境下会解析到该段；仅在有此类代理的主机开启，
# 默认 false 保持 SSRF fail-closed（ECS/生产环境请保持关闭）。
OPS_ALLOW_PROXY_BENCHMARK_IPS=false
OPS_ADMIN_USERNAME=
OPS_ADMIN_PASSWORD=

# 云服务健康巡检（可选；未配置对应探针跳过）
OPS_HEALTH_API_URL=
OPS_HEALTH_LOGTO_URL=
OPS_HEALTH_TARGETS=

# 兑换码签发密钥（须与桌面端 REDEMPTION_SECRET 一致）
OPS_REDEMPTION_SECRET=

# 运行时配置签名私钥（Ed25519 PEM，必填！未配置 → /api/v1/runtime/bootstrap 返回 404 fail-closed）。
# 桌面端会对 bootstrap 响应验签（内置默认公钥，或运营中心同步配置中自定义公钥），
# 验签不通过时整个运行时策略（公告/版本/敏感词/pipelineOptions）不应用。
# 生成方式（Linux/Windows）：
#   python3 -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k=Ed25519PrivateKey.generate(); open('runtime-signing-private.pem','wb').write(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())); open('runtime-signing-public.pem','wb').write(k.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo))"
# 私钥内容含换行，写入 .env 时用双引号包裹；或指定文件路径（二选一，路径优先）
OPS_RUNTIME_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIMEaqZBFhrl/hpieWHhYoaG6Dn+Juchfx4/2s0dXok0S
-----END PRIVATE KEY-----"
# OPS_RUNTIME_SIGNING_KEY_PATH=/data/ops-center/runtime-signing-private.pem
# 桌面端内置的默认公钥与上面默认私钥 DEV KEY 配对，仅用于开发/演示；生产务必自行生成密钥对，
# 并在桌面端「运营中心同步」配置中填入自定义 Ed25519 公钥，保证验签信任锚唯一。
# 生成公钥后按下面格式交由桌面端配置（含换行）：
#   -----BEGIN PUBLIC KEY----- ...
#   -----END PUBLIC KEY-----

# Logto OIDC 验证（零配置同步：桌面端用户 JWT 替代静态 Key；未配置 = 仅接受 OPS_CATALOG_API_KEY）
OPS_LOGTO_ENDPOINT=
OPS_LOGTO_API_RESOURCE=
OPS_LOGTO_JWKS_CACHE_TTL=300
