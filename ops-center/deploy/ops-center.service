[Unit]
Description=OpsCenter - 运营配置中心
After=network.target

[Service]
Type=simple
User=ops-center
Group=ops-center
WorkingDirectory=/opt/ops-center/backend
EnvironmentFile=/etc/ops-center/env
Environment=OPS_DB_PATH=/data/ops-center/config.db
Environment=OPS_CONFIG_OUTPUT_DIR=/data/configs
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/ops-center /data/configs

[Install]
WantedBy=multi-user.target
