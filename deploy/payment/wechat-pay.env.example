# 微信支付商户凭据（**只放这里**，不要写进 deploy/logto/api.env）
#
# 用法（两个 --env-file，Compose v2.24+ 支持多文件，后者覆盖前者）：
#   docker compose -f packages/api-publish-engine/docker-compose.yml \
#     --env-file deploy/logto/api.env \
#     --env-file deploy/payment/wechat-pay.env \
#     up -d
#
# ⛔ 真实值写进 `deploy/payment/wechat-pay.env`（已被 .gitignore 忽略），本文件只放空占位符。
#
# 为什么单独一个文件：
#   `deploy/logto/api.env` 是**业务 API 自身**的环境（Logto / PostgreSQL / entitlement），
#   微信商户凭据与它没有关系。混在一起会让"改身份认证的人"手上有商户私钥，
#   也会让轮换支付密钥时必须动身份认证的配置文件。

# ── 开关 ──────────────────────────────────────────────────────────────
# none = 支付入口关闭（fail-closed，前端显示「支付通道暂未开放」）；启用时改 wechat_native
PAYMENT_PROVIDER=none

# ── 商户身份 ──────────────────────────────────────────────────────────
# 商户平台首页右上角 / 账户中心 → 商户信息，10 位数字
WECHAT_PAY_MCH_ID=
# 微信公众平台 → 开发 → 开发管理 → 开发设置；或商户平台「产品中心 → AppID 账号管理」，wx 开头
WECHAT_PAY_APPID=

# ── APIv3 密钥（32 字符，只显示一次）────────────────────────────────────
# 商户平台 → 账户中心 → API 安全 → APIv3 密钥 → 设置
WECHAT_PAY_API_V3_KEY=

# ── 商户证书（下单签名用）─────────────────────────────────────────────
# 证书序列号（40 位十六进制）：账户中心 → API 安全 → API 证书
WECHAT_PAY_CERT_SERIAL_NO=
# 商户私钥，二选一：
#   _PATH    = **容器内**路径。把 apiclient_key.pem 放到
#              packages/api-publish-engine/config/wechat-pay/ 下，
#              容器里就是 /app/packages/api-publish-engine/config/wechat-pay/apiclient_key.pem
#   _CONTENT = PEM 全文（⚠️ 环境变量会被 docker inspect 看到，优先用 _PATH）
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_CERT_CONTENT=

# ── 微信支付公钥（回调验签用，与商户私钥同等必需）──────────────────────
# 账户中心 → API 安全 → 微信支付公钥（2024+ 公钥模式；不是旧的「平台证书」）
# 二选一：裸 Base64 或 PEM
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 公钥 ID，形如 PUB_KEY_ID_…；配了就按它核对回调头里的 serial，对不上即拒（fail-closed）
WECHAT_PAY_PUBLIC_KEY_ID=

# ── 回调地址 ──────────────────────────────────────────────────────────
# 必须公网 HTTPS，且与商户平台「开发配置 → 支付回调」**逐字一致**
WECHAT_PAY_NOTIFY_URL=
