# 业务 API 生产环境变量模板。这里只列名称和安全占位符，不填真实 Secret。
# ⛔ 本文件是**模板**，只放空占位符。真实值一律写进 deploy/logto/api.env（已被 .gitignore 忽略）。
#    不要在本文件里填任何真实凭据 —— 它会被提交。
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_KEYS_PATH=/app/packages/api-publish-engine/config/api-keys.json

# shadow 阶段 required=false；切换 required 前运行 validate-production-config --phase required。
IDENTITY_AUTH_ENABLED=true
IDENTITY_AUTH_REQUIRED=false
BUSINESS_DATABASE_AUTO_MIGRATE=false
# 默认使用仓库 `migrations/postgresql`；独立打包时可指向只读 migration 目录。
BUSINESS_DATABASE_MIGRATIONS_DIR=
# 业务 API 需要加入 deploy/logto 创建的网络，才能解析 BUSINESS_DATABASE_URL 中的 postgres 服务名。
LOGTO_COMPOSE_NETWORK=multi-publish-logto_default

# Logto issuer 可填 https://id.example.com 或完整 /oidc issuer。
LOGTO_ENDPOINT=
LOGTO_API_RESOURCE=https://api.example.com

# 必填：Logto Machine-to-Machine 应用凭证，用于验证 Opaque Access Token。
# 生产配置门禁会拒绝任一空值；凭据只进入业务 API Secret Store。
# 在 Logto Admin Console 创建 M2M 应用并授予该 API Resource 的 publish:submit / profile:read 等权限。
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=

# 必须与 Logto DB 分离；Secret Store 注入，不要提交到仓库。
BUSINESS_DATABASE_URL=
LOGTO_DATABASE_URL=
LOGTO_WEBHOOK_SIGNING_KEY=
ENTITLEMENT_KEY_ID=
ENTITLEMENT_PRIVATE_KEY=

LOGTO_JWKS_CACHE_TTL=300
LOGTO_WEBHOOK_MAX_EVENT_AGE_SECONDS=900
LOGTO_WEBHOOK_MAX_FUTURE_SKEW_SECONDS=300
MAX_RPM=100
ENABLE_SCHEDULE=false

# ───────────────────────────── 微信 Native 支付 ─────────────────────────────
# `none` = 支付入口关闭（默认，fail-closed）；启用时改 wechat_native 并补齐下面各项。
# 缺任何一项，`payment-preflight` 会 FAIL，`validate-production-config --phase required` 也会拒。
# ⛔ 本文件含商户私钥与 APIv3 密钥，**已在 .gitignore 里**（deploy/logto/api.env），不要提交。
PAYMENT_PROVIDER=none
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
# 32 个字符：商户平台 → 账户中心 → API 安全 → APIv3 密钥
WECHAT_PAY_API_V3_KEY=
# 商户证书序列号（40 位十六进制）：API 安全 → API 证书
WECHAT_PAY_CERT_SERIAL_NO=
# 商户私钥，二选一：
#   _PATH    = **容器内**路径。把 apiclient_key.pem 放到 packages/api-publish-engine/config/wechat-pay/ 下，
#              容器里就是 /app/packages/api-publish-engine/config/wechat-pay/apiclient_key.pem
#   _CONTENT = PEM 全文（⚠️ 走环境变量会被 docker inspect 看到，优先用 _PATH）
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_CERT_CONTENT=
# 微信支付公钥（回调验签，与商户私钥同等必需），二选一：裸 Base64 或 PEM
# 管理端：账户中心 → API 安全 → 微信支付公钥（2024+ 用公钥模式，不再是「平台证书」）
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 微信支付公钥 ID，形如 PUB_KEY_ID_…；配了就按它核对回调头里的 serial，对不上即拒
WECHAT_PAY_PUBLIC_KEY_ID=
# 回调完整 URL，必须公网 HTTPS，且与商户平台「开发配置 → 支付回调」逐字一致
WECHAT_PAY_NOTIFY_URL=

