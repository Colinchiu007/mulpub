# Multi-Publish 环境配置
# 复制此文件为 .env 并填入实际值
# .env 已加入 .gitignore，不会提交到仓库

# Python 后端
BACKEND_PORT=8299
BACKEND_HOST=127.0.0.1

# Orchestrator API（用于 Cookie 推送，生产环境使用 https）
ORCHESTRATOR_URL=https://your-orchestrator-domain.com
ORCHESTRATOR_API_KEY=

# Logto 用户身份（Native Application + Authorization Code/PKCE）
# 开发环境从启动 Electron 的进程环境读取；发行包默认读取 config/identity-public.json，且其中的启用开关不接受环境覆盖。
# 私钥、Webhook signing key、Management Token 和数据库凭据绝不能放入桌面端。
IDENTITY_AUTH_ENABLED=false
IDENTITY_AUTH_REQUIRED=false
LOGTO_ENDPOINT=https://auth.iart.work
LOGTO_APP_ID=pazqt9xsqi0r63g5cfbrn
LOGTO_API_RESOURCE=https://api.multi-publish.com
LOGTO_REDIRECT_URI=http://127.0.0.1:16526/auth/callback
LOGTO_SCOPES=openid profile offline_access profile:read publish:submit publish:read account:manage cloud:publish
LOGTO_JWKS_CACHE_TTL=300
# API 请求基址通过 auth.iart.work/api/ 反代；LOGTO_API_RESOURCE 仍是 Token audience。
BUSINESS_API_URL=https://auth.iart.work

# 业务 API PostgreSQL（与 Logto 自身数据库隔离，仅服务端使用）
BUSINESS_DATABASE_URL=postgresql://multi_publish:replace-me@127.0.0.1:5432/multi_publish

# Entitlement 离线快照验证（只配置公钥；私钥仅存在于服务端 Secret Store）
ENTITLEMENT_PUBLIC_KEY=
ENTITLEMENT_KEY_ID=entitlement-2026-07-24
ENTITLEMENT_OFFLINE_GRACE_SECONDS=604800

# 仅业务服务端使用，禁止打包进 Electron
ENTITLEMENT_PRIVATE_KEY=

# 微信 Native 扫码支付（会员中心在线支付）。**仅业务服务端**，绝不打包进 Electron。
#
# ⚠️ 三份模板各管一段，别填错地方：
#    · 本文件（根目录 .env.example）→ **本地开发**直接 node 跑业务 API 时用
#    · deploy/logto/api.env         → 生产/Compose：业务 API 自身的 Logto / PostgreSQL / entitlement
#    · deploy/payment/wechat-pay.env → 生产/Compose：**微信商户凭据只放这里**（与身份认证配置分开）
#    生产启动要传两个 --env-file，见 01-docs/RUNBOOK-WECHAT-PAY-E2E-2026-10-23.md §2。
#
# PAYMENT_PROVIDER=none 是默认值：入口 fail-closed 隐藏，兑换码/后台开通两条既有通道不受影响。
# 启用时填 wechat_native 并补齐下面各项；production-config 与 payment-preflight 都会 fail-fast。
# ⛔ 这些变量必须同时出现在 packages/api-publish-engine/docker-compose.yml 的 environment 里，
#    否则容器读不到（表现：模板写得再对，前端仍显示「支付通道暂未开放」）。
#    接线锁：packages/api-publish-engine/test/payment-env-passthrough.test.js
PAYMENT_PROVIDER=none
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
# 必须是 32 个字符（商户平台「账户中心 → API 安全」里的 APIv3 密钥）
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
# 商户私钥 apiclient_key.pem 的路径（**容器内路径**；放 packages/api-publish-engine/config/ 下即被 bind 进容器）
# 与 WECHAT_PAY_CERT_CONTENT **二选一**：后者放 PEM 全文，适合密钥管理注入
# （⚠️ 走环境变量会被 `docker inspect` 看到，优先用文件）
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_CERT_CONTENT=
# 平台公钥（**回调验签用，与商户私钥同等必需**）：微信 2024+ 的「微信支付公钥」，裸 Base64 或 PEM 均可
# 与 WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH **二选一**
# ⛔ 缺它的后果不是"支付不可用"，而是"付了钱拿不到权益"：下单能出码，但所有 webhook 401
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 微信支付公钥 ID（形如 PUB_KEY_ID_…）。配了就按它核对回调头里的 serial，对不上即拒
# —— 换公钥却没更新配置时必须吵出来，不能拿旧公钥默默验过
WECHAT_PAY_PUBLIC_KEY_ID=
# 回调完整 URL，必须公网 HTTPS 且与商户平台配置一致，例：https://<域名>/api/v1/webhooks/payment
WECHAT_PAY_NOTIFY_URL=
# 仅业务服务端使用，禁止打包进 Electron
LOGTO_WEBHOOK_SIGNING_KEY=
LOGTO_WEBHOOK_MAX_EVENT_AGE_SECONDS=900
LOGTO_WEBHOOK_MAX_FUTURE_SKEW_SECONDS=300
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# 加密主密码（生产环境必填，用于派生 AES 密钥；开发模式可留空使用随机密钥）
MASTER_PASSWORD=

# JWT 签名密钥（生产环境必填；开发模式可留空使用随机密钥）
JWT_SECRET=

# AiWriter API 认证密钥（必填，未设置时服务拒绝启动）
AI_WRITER_API_KEY=

# 兑换码 HMAC 密钥（生产环境必填，未设置时 generate/validate 会抛错）
REDEMPTION_SECRET=

# API Keys（可选）
# TIKHUB_API_KEY=your_key_here

# api-publish-engine 独立服务所需（可选，仅使用 API 模式发布时需要）
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# OPENAI_API_KEY=
# AI_API_URL=

# 运行时路径覆盖（自定义部署时可选）
# MULTI_PUBLISH_ROOT=
# MULTI_PUBLISH_CONFIG_PATH=
# MULTI_PUBLISH_PLUGINS_DIR=

# 旧 Python RPA 明文认证仅用于非生产环境的受控迁移；两个开关必须同时为 1。
# NODE_ENV/MULTI_PUBLISH_ENV/APP_ENV 为 production 或 prod 时强制禁用。
# 桌面端正常运行始终使用 Electron 加密凭据存储。
# MULTI_PUBLISH_ALLOW_LEGACY_PLAINTEXT_AUTH=0
# MULTI_PUBLISH_LEGACY_AUTH_MIGRATION=0
